{
    "name": "tikhomirov/moonshine-yandex-metrika",
    "description": "Yandex Metrika + Webmaster analytics dashboard for MoonShine 5.x",
    "keywords": [
        "laravel",
        "moonshine",
        "yandex",
        "metrika",
        "webmaster",
        "analytics",
        "dashboard"
    ],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/tikhomirov/moonshine-yandex-metrika",
    "support": {
        "issues": "https://github.com/tikhomirov/moonshine-yandex-metrika/issues",
        "source": "https://github.com/tikhomirov/moonshine-yandex-metrika"
    },
    "authors": [
        {
            "name": "Aleksei Tikhomirov",
            "email": "alex@rwsite.ru",
            "homepage": "https://github.com/tikhomirov"
        }
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.0 || ^8.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "moonshine/moonshine": "^5.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Tikhomirov\\MoonshineYandexMetrika\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tikhomirov\\MoonshineYandexMetrika\\Tests\\": "tests/"
        },
        "files": [
            "tests/Support/yandex_api_helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tikhomirov\\MoonshineYandexMetrika\\MoonshineYandexMetrikaServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --memory-limit=512M",
        "lint": "vendor/bin/pint",
        "lint:test": "vendor/bin/pint --test",
        "test": "vendor/bin/pest -c phpunit.xml.dist",
        "test:coverage": "vendor/bin/pest -c phpunit.xml.dist --coverage --min=100",
        "test:types": "vendor/bin/pest -c phpunit.xml.dist --type-coverage --min=100",
        "test:mutate": "vendor/bin/pest -c phpunit.xml.dist --mutate --min=100",
        "ci": [
            "@lint:test",
            "@analyse",
            "@test:types",
            "@test:coverage",
            "@test:mutate"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}