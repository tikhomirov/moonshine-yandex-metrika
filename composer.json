{
    "name": "tikhomirov/moonshine-yandex-metrika",
    "description": "Yandex Metrika dashboard page for MoonShine 4.x admin panel",
    "keywords": ["laravel", "moonshine", "yandex", "metrika", "analytics", "dashboard"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Your Name",
            "email": "you@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "moonshine/moonshine": "^4.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Tikhomirov\\MoonshineYandexMetrika\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tikhomirov\\MoonshineYandexMetrika\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tikhomirov\\MoonshineYandexMetrika\\MoonshineYandexMetrikaServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
